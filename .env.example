# Modelo de arquivo de ambiente do backend.
#
#   cp .env.example .env.dev   → DEV local (Supabase local) — usado por
#                                npm run dev | migrate:up | db:seed ...
#   cp .env.example .env.tcc   → TCC (Supabase do TCC na nuvem) — usado por
#                                npm run dev:tcc | migrate:tcc | db:seed:tcc ...
#
# NÃO crie `.env` nem `.env.prod` nesta pasta: credenciais de produção
# existem só no Railway (e no cofre de senhas). Nenhum `.env*` é versionado.

PORT=3000

# Valores abaixo = padrão do Supabase local (`supabase start`).
# As chaves aparecem em `supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:8081

# Fixtures de teste (usadas por db:seed / db:clean). Senhas só são usadas
# quando o usuário ainda não existe no Supabase Auth.
HML_FIXTURE_HOUSE_NAME=Casa Fixture
HML_FIXTURE_ADMIN_EMAIL=teste.admin@fixture.example
HML_FIXTURE_ADMIN_PASSWORD=
HML_FIXTURE_MEMBER1_EMAIL=teste.membro1@fixture.example
HML_FIXTURE_MEMBER1_PASSWORD=
HML_FIXTURE_MEMBER2_EMAIL=teste.membro2@fixture.example
HML_FIXTURE_MEMBER2_PASSWORD=
