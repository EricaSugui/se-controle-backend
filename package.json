{
  "name": "secontrole-backend",
  "version": "1.0.0",
  "description": "Backend do app de controle financeiro",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "dotenv -e .env.dev -- ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:tcc": "dotenv -e .env.tcc -- ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "dotenv -e .env.dev -- node dist/server.js",
    "start:tcc": "dotenv -e .env.tcc -- node dist/server.js",
    "test": "jest --runInBand",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "node-pg-migrate up --envPath .env.dev",
    "migrate:down": "node-pg-migrate down --envPath .env.dev",
    "migrate:tcc": "node-pg-migrate up --envPath .env.tcc",
    "migrate:down:tcc": "node-pg-migrate down --envPath .env.tcc",
    "db:seed": "dotenv -e .env.dev -- node scripts/seed-fixtures-db.js",
    "db:clean": "dotenv -e .env.dev -- node scripts/clean-fixtures-db.js",
    "db:reset": "npm run db:clean && npm run db:seed",
    "db:seed:tcc": "dotenv -e .env.tcc -- node scripts/seed-fixtures-db.js",
    "db:clean:tcc": "dotenv -e .env.tcc -- node scripts/clean-fixtures-db.js",
    "db:reset:tcc": "npm run db:clean:tcc && npm run db:seed:tcc",
    "supabase:start": "bash scripts/dev-supabase.sh start",
    "supabase:stop": "bash scripts/dev-supabase.sh stop",
    "supabase:reset": "bash scripts/dev-supabase.sh reset",
    "supabase:status": "bash scripts/dev-supabase.sh status",
    "db:backup:prod": "bash scripts/backup-db.sh prod",
    "db:backup:tcc": "bash scripts/backup-db.sh tcc",
    "db:restore-test": "bash scripts/restore-test-db.sh",
    "db:restore:prod": "bash scripts/restore-db.sh prod",
    "db:restore:tcc": "bash scripts/restore-db.sh tcc",
    "openapi:bundle": "redocly bundle openapi.yml -o openapi.bundled.yml",
    "exp:recriar": "bash experimento/scripts/recriar-banco.sh",
    "exp:ambiente": "node experimento/scripts/ambiente.js",
    "exp:parar": "docker compose -f experimento/docker-compose.yml down -v",
    "exp:test": "bash experimento/scripts/testar.sh",
    "exp:typecheck": "tsc -p experimento/tsconfig.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-pg-migrate": "^8.0.4",
    "pdfkit": "^0.20.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.38.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.1.0",
    "jest": "^30.5.2",
    "supabase": "^3.2.0",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
